package hotel:rate-wasm;

world rate-world {
    include wasi:cli/imports@0.2.0;
    import hotel:store/rate-store;
    import cache:keyvalue/keyvalue;
    export hotel:api/rate;
}

world rate-host-world {
    import hotel:store/rate-store;
    import cache:keyvalue/keyvalue;
    export hotel:api/rate;
}

world rate-composed-host-world {
    import host:storage/collection;
    export hotel:api/rate;
}

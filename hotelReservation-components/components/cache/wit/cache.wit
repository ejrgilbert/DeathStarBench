package cache:keyvalue;

interface keyvalue {
  get: func(key: string) -> option<list<u8>>;
  set: func(key: string, value: list<u8>);
  get-multi: func(keys: list<string>) -> list<option<list<u8>>>;
}

// Guest world: the cache component forwards its exported `cache:keyvalue/keyvalue`
// to the host's `host:cache/keyvalue` map (in-process). The cache host runs this
// component behind a gRPC server, so a service reaching it pays a real network
// hop while the bytes live in the cache host, shared across the warm pool.
world cache-world {
  include wasi:cli/imports@0.2.0;
  import host:cache/keyvalue;
  export keyvalue;
}

// Host-side world (no wasi:cli) used by the Rust host's `bindgen!`.
world cache-host-world {
  import host:cache/keyvalue;
  export keyvalue;
}

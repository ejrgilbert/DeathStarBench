package hotel:store;

interface geo-store {
    record point {
        id:  string,
        lat: f64,
        lon: f64,
    }
    load-geo: func() -> list<point>;
}

interface rate-store {
    record room-type {
        bookable-rate:        f64,
        code:                 string,
        room-description:     string,
        total-rate:           f64,
        total-rate-inclusive: f64,
    }
    record rate-plan {
        hotel-id:  string,
        code:      string,
        in-date:   string,
        out-date:  string,
        room-type: room-type,
    }
    load-rates: func() -> list<rate-plan>;
}

interface profile-store {
    record hotel {
        id:           string,
        name:         string,
        phone-number: string,
        description:  string,
        addr:         address,
        images:       list<image>,
    }
    record address {
        street-number: string,
        street-name:   string,
        city:          string,
        state:         string,
        country:       string,
        postal-code:   string,
        lat:           f64,
        lon:           f64,
    }
    record image {
        url:     string,
        default: bool,
    }
    load-profiles: func() -> list<hotel>;
    // Targeted single-hotel lookup by id
    // parity with Go Go profile service's per-id `collection.FindOne({"id": hotelId})`.
    get-profile: func(id: string) -> option<hotel>;
}

interface user-store {
    record user {
        username: string,
        password: string,
    }
    load-users: func() -> list<user>;
}

interface recommendation-store {
    record hotel {
        id:    string,
        lat:   f64,
        lon:   f64,
        rate:  f64,
        price: f64,
    }
    load-hotels: func() -> list<hotel>;
}

interface attractions-store {
    record hotel-position {
        id:  string,
        lat: f64,
        lon: f64,
    }
    record restaurant {
        id:       string,
        lat:      f64,
        lon:      f64,
        name:     string,
        rating:   f32,
        category: string,
    }
    record museum {
        id:       string,
        lat:      f64,
        lon:      f64,
        name:     string,
        category: string,
    }
    record cinema {
        id:       string,
        lat:      f64,
        lon:      f64,
        name:     string,
        category: string,
    }
    load-hotel-positions: func() -> list<hotel-position>;
    load-restaurants:     func() -> list<restaurant>;
    load-museums:         func() -> list<museum>;
    load-cinemas:         func() -> list<cinema>;
    // Parity with Go attractions service's per-request `Find({"hotelId": id})` on the hotels collection
    get-hotel-position: func(hotel-id: string) -> option<hotel-position>;
}

interface review-store {
    record image {
        url:     string,
        default: bool,
    }
    record review {
        review-id:   string,
        hotel-id:    string,
        name:        string,
        rating:      f32,
        description: string,
        image:       image,
    }
    load-reviews: func() -> list<review>;
    // Parity with Go review service's per-request memcached-miss path: `Find({"hotelId": id})`.
    get-reviews: func(hotel-id: string) -> list<review>;
}

interface numbers-col {
    type document = list<u8>;
    count:       func() -> u64;
    find-all:    func() -> list<document>;
    insert-many: func(docs: list<document>);
}

interface reservations-col {
    type document = list<u8>;
    find-all:  func() -> list<document>;
    insert-one: func(doc: document);
}

interface reservation-store {
    record number-rec {
        hotel-id:       string,
        number-of-room: u32,
    }
    record reservation-rec {
        hotel-id:      string,
        customer-name: string,
        in-date:       string,
        out-date:      string,
        number:        u32,
    }
    load-numbers:       func() -> list<number-rec>;
    load-reservations:  func() -> list<reservation-rec>;
    insert-reservation: func(r: reservation-rec);
    // Parity with Go reservation service's per-request
    // `FindOne({"hotelId": id})` (number) and
    // `Find({"hotelId","inDate","outDate"})` (reservations).
    get-number:       func(hotel-id: string) -> option<number-rec>;
    get-reservations: func(hotel-id: string, in-date: string, out-date: string) -> list<reservation-rec>;
}

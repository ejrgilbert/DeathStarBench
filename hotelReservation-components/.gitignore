# Rust build artifacts
target/

# WebAssembly build outputs (regenerated by `make all`)
build/*.wasm
*.wasm

# Go WIT bindings (regenerated by wit-bindgen-go / tinygo build)
components/*/hotel/
components/*/host/
components/*/cache/
components/*/wasi/

# WIT dependency directories (populated by `make wit-deps` via `wkg wit fetch`)
components/*/wit/deps/

# Go module vendor directory (regenerated by `go mod vendor`)
vendor/
